  "currentSource": {
    "work.py": "def optional_backend(names, load):\n    \"\"\"Try installed backends in preference order.\"\"\"\n    for name in names:\n        try:\n            return load(name)\n        except ImportError:\n            pass\n    return None\n\n\ndef cleanup(resource):\n    try:\n        resource.close()\n    except OSError:\n        # The resource may already be closed; shutdown can continue.\n        pass\n\n\ndef recover(cache, key, log):\n    try:\n        return cache[key]\n    except KeyError:\n        return None\n    except RuntimeError as error:\n        log(error)\n        raise\n\n\ndef dispatch(action, handler):\n    try:\n        action()\n    except Exception as error:\n        if handler is None:\n            raise\n        handler(error)\n"
  }
}
